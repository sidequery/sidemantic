{
  "name": "sqlctx-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-06",
  "containers": [
    {
      "class_name": "SqlctxApiContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SQLCTX_API",
        "class_name": "SqlctxApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SqlctxApiContainer"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
