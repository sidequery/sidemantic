#include "duckdb/parser/parser_options.hpp"
#if SQLCTX_NEW_IDENTIFIER_API
#include "duckdb/common/identifier.hpp"
#endif

namespace duckdb {
#if SQLCTX_NEW_IDENTIFIER_API
using SqlctxIdentifier = Identifier;
inline const string &SqlctxName(const Identifier &name) { return name.GetIdentifierName(); }
#else
using SqlctxIdentifier = string;
#endif
inline const string &SqlctxName(const string &name) { return name; }

inline ParserOptions SqlctxBuiltinParserOptions() {
#if SQLCTX_BUILTIN_PARSER_OPTIONS
    return ParserOptions::Builtin();
#else
    return ParserOptions();
#endif
}
} // namespace duckdb
