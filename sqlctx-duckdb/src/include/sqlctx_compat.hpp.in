#pragma once

#cmakedefine01 SQLCTX_TOKEN_PARSE_FN
#cmakedefine01 SQLCTX_NEW_IDENTIFIER_API
#cmakedefine01 SQLCTX_NEW_EXPRESSION_API
#cmakedefine01 SQLCTX_QUALIFIED_TABLE_API
#cmakedefine01 SQLCTX_BUILTIN_PARSER_OPTIONS
#cmakedefine01 SQLCTX_LITERAL_API
#cmakedefine01 SQLCTX_GRAMMAR_EXTENSION
#cmakedefine01 SQLCTX_INSERT_QUERY_NODE
#cmakedefine01 SQLCTX_BOUND_TABLE_FUNCTION
