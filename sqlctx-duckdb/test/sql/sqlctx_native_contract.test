# name: test/sql/sqlctx_native_contract.test
# description: Test native sqlctx YAML and SQL contract paths in the DuckDB extension
# group: [sqlctx]

load __TEST_DIR__/sqlctx_native_contract.duckdb

require sqlctx

statement ok
CREATE TABLE native_customers (customer_id INT, country VARCHAR, credit_limit INT);

statement ok
CREATE TABLE native_orders (order_id INT, customer_id INT, status VARCHAR, amount INT);

statement ok
INSERT INTO native_customers VALUES (1, 'CA', 100), (2, 'US', 100);

statement ok
INSERT INTO native_orders VALUES (101, 1, 'paid', 120), (102, 2, 'paid', 200), (103, 2, 'pending', 50);

statement ok
SELECT * FROM sqlctx_load('
version: 1
models:
  - name: native_orders
    table: native_orders
    primary_key: order_id
    dimensions:
      - name: customer_id
        type: numeric
      - name: status
        type: categorical
    metrics:
      - name: revenue
        agg: sum
        sql: amount
    relationships:
      - name: native_customers
        type: many_to_one
        foreign_key: customer_id
        primary_key: customer_id
  - name: native_customers
    table: native_customers
    primary_key: customer_id
    dimensions:
      - name: country
        type: categorical
    metrics:
      - name: total_credit
        agg: sum
        sql: credit_limit
      - name: customer_count
        agg: count
');

query IR rowsort
SEMANTIC SELECT native_customers.country, native_orders.revenue FROM native_orders ORDER BY native_customers.country;
----
CA	120
US	250

query IR rowsort
SELECT native_customers.country, native_orders.revenue FROM native_orders ORDER BY native_customers.country;
----
CA	120
US	250

query I
SELECT sqlctx_rewrite_sql('SELECT native_orders.revenue, native_customers.country FROM native_orders') LIKE '%JOIN%';
----
true

# Customer 2 repeats across two orders. Each customer's credit must contribute
# once, even though both customers have the same credit value (SUM DISTINCT
# would incorrectly collapse them). Order revenue retains all three rows.
query III
SEMANTIC SELECT native_orders.revenue, native_customers.total_credit, native_customers.customer_count FROM native_orders;
----
370	200	2

query TII rowsort
SEMANTIC SELECT native_orders.status, native_customers.total_credit, native_customers.customer_count FROM native_orders;
----
paid	200	2
pending	100	1

statement ok
COPY (SELECT 'MODEL (name native_events, table native_events, primary_key event_id); METRIC (name event_count, agg count);' AS line) TO '__TEST_DIR__/native_definitions.sqlctx.sql' (HEADER false, QUOTE '');

statement ok
CREATE TABLE native_events (event_id INT);

statement ok
INSERT INTO native_events VALUES (1), (2), (3), (4);

statement ok
SELECT * FROM sqlctx_load_file('__TEST_DIR__/native_definitions.sqlctx.sql');

query I rowsort
SELECT * FROM sqlctx_models();
----
native_customers
native_events
native_orders

query I
SEMANTIC SELECT native_events.event_count FROM native_events;
----
4

statement error
SELECT * FROM sqlctx_load('
version: 999
models:
  - name: unsupported_native
    table: unsupported_native
    primary_key: id
');
----
Unsupported native sqlctx format version
